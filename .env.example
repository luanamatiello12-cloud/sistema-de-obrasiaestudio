# Configuração do Supabase.
# Sem estas variáveis, o app roda em MODO DEMO (dados no navegador).
# Preencha as duas linhas para ligar o backend real e sair do modo demo.
#
# Onde achar: painel do Supabase > Project Settings > API
#   - VITE_SUPABASE_URL      = "Project URL"
#   - VITE_SUPABASE_ANON_KEY = chave "anon public"
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-public-aqui"
